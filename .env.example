# Polar v2 — the ONLY required setting.
# 1. Create a free MongoDB Atlas cluster (M0, free tier) at https://cloud.mongodb.com
# 2. Click "Connect" -> "Drivers" and copy your connection string.
# 3. Paste it below (replace <db_password> with your database user's password).
MONGODB_URI=mongodb+srv://<username>:<db_password>@<cluster>.mongodb.net/polar?retryWrites=true&w=majority

# Optional — if left blank, Polar generates a random secret at boot and warns you.
# Sessions will be invalidated on every restart without a fixed secret, so set
# one for any real deployment (any long random string works).
# JWT_SECRET=change-me-to-a-long-random-string

# Optional — defaults to 3000.
# PORT=3000

# Optional — friends-only signup gate. Only set this on a hosted instance you
# share with friends: set the same value as an env var in your host dashboard
# (e.g. Render) and share it privately with your friends — never commit it.
# Leave it unset to keep signup open (the default for anyone cloning the
# repo to self-host their own instance).
# SIGNUP_CODE=your-private-invite-code

# Optional — owner account. Set this to YOUR username (as an env var in
# your host dashboard, e.g. Render) and that account gets the Admin panel:
# list all users and rooms, delete rooms and users. It is not a password and
# never grants access on its own — you still log in normally. Leave it unset
# and nobody is owner (the default for anyone cloning the repo to self-host).
# OWNER_USERNAME=your-username

# Optional — only needed for voice calls behind strict NATs (see README "Voice calls").
# TURN_URL=turn:your-turn-server:3478
# TURN_USERNAME=
# TURN_PASSWORD=
